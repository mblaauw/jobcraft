      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./data/**)",
      "Read(./seed/**)",
      "Read(./.runtime/**)",
      "Read(./docs/private/**)",
      "Read(./bootstrap-accounts.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./data/**)",
      "Edit(./seed/**)",
      "Edit(./.runtime/**)",
      "Edit(./docs/private/**)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
