{
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run python scripts/matching_quality.py*)",
      "Bash(node --check *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
