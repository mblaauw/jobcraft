# OpenAI-compatible LLM endpoint (never commit real keys)
LLM_BASE_URL=
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-v4.1-flash

# Local web auth. APP_USER / APP_PASSWORD seed the first (legacy) account only;
# after that, manage passwords in the app.
APP_USER=owner
APP_PASSWORD=replace-me

# Optional overrides
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=2
# LLM_STRUCTURED=json_schema
# APP_DATA_DIR=./data
# APP_RUNTIME_DIR=./.runtime
# APP_SEED_DIR=./seed

# System One decision gate (Jev via Runware). Without a key the app falls back to
# rule + LLM matching; with it, Jev scores every job cheaply first.
RUNWARE_API_KEY=replace-me
# SYSTEMONE_MODEL=typesafe:jev@1
# SYSTEMONE_CONFIDENCE=0.75
# SYSTEMONE_BATCH=40
# MATCH_BATCH=12
# MATCH_MIN_RANK=35
