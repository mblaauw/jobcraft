# OpenAI-compatible LLM endpoint (never commit real keys)
LLM_BASE_URL=
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-v4.1-flash

# Local web auth. APP_USER / APP_PASSWORD seed the first (legacy) account only;
# after that, manage passwords in the app.
APP_USER=owner
APP_PASSWORD=replace-me

# Optional overrides
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=2
# LLM_STRUCTURED=json_schema
# APP_DATA_DIR=./data
# APP_RUNTIME_DIR=./.runtime
# APP_SEED_DIR=./seed

# System One decision gate (Jev). Without a key the app falls back to rule + LLM
# matching; with it, Jev scores every job cheaply first. Runware is the default;
# for OpenCode use SYSTEMONE_URL=https://opencode.ai/inference/systemone/v1/systemone,
# SYSTEMONE_MODEL=jev-1.13 and SYSTEMONE_API_KEY (the same key as LLM_API_KEY).
RUNWARE_API_KEY=replace-me
# SYSTEMONE_API_KEY=
# SYSTEMONE_URL=https://api.runware.ai/v1/decisions
# SYSTEMONE_MODEL=typesafe:jev@1
# SYSTEMONE_CONFIDENCE=0.75
# SYSTEMONE_BATCH=40
# Jev calls per account per day. They do not count toward AI_DAILY_TOKEN_LIMIT.
# SYSTEMONE_DAILY_LIMIT=80
# Personal fit is only asked for this many of an account's best-ranked jobs.
# SYSTEMONE_FIT_TOP=200
# Assessment rounds per trigger (scan or profile change), each up to 12 LLM verdicts,
# stopping at MATCH_DAILY_BUDGET_USD, or at AI_DAILY_TOKEN_LIMIT per account (default
# 500000) when the gateway reports no prices.
# MATCH_AUTO_ROUNDS=3
# MATCH_BATCH=12
# MATCH_MIN_RANK=35
# Local meaning index: a folder with a model2vec model (the image has one). Set 0 to turn it off.
# EMBED_MODEL=/opt/models/potion-multilingual-128M

# Optional: daily job email. Without SMTP_HOST and SMTP_FROM nothing is ever sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# APP_BASE_URL=https://jobcraft.example
# DIGEST_TIME=08:30

# Development only: also create the member account `test-user` at first start.
# BOOTSTRAP_TEST_USER=1

# all: one process does everything (local development).
# web / worker: separate processes on the same data; compose.yaml sets these itself.
# APP_ROLE=all

# New-match updates. Badge from this rank; an email at most every 6 hours from the second.
# NOTIFY_MIN_RANK=65
# NOTIFY_ALERT_RANK=80

# Days to keep the per-account AI log with each call's input and output.
# AI_LOG_DAYS=30
# Sign-in history (moment, address, browser) kept this many days for administrators.
# AUTH_LOG_DAYS=90
# Behind a reverse proxy, let uvicorn trust X-Forwarded-For from it, so the sign-in
# log and the login rate limit see visitors instead of the proxy (deploy/compose.vps.yml).
# FORWARDED_ALLOW_IPS=*
