# OpenAI-compatible LLM endpoint (never commit real keys)
LLM_BASE_URL=
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-v4.1-flash

# Local web auth. APP_USER / APP_PASSWORD seed the first (legacy) account only;
# after that, manage passwords in the app.
APP_USER=owner
APP_PASSWORD=replace-me

# Optional overrides
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=2
# LLM_STRUCTURED=json_schema
# APP_DATA_DIR=./data
# APP_RUNTIME_DIR=./.runtime
# APP_SEED_DIR=./seed

# System One decision gate (Jev via Runware). Without a key the app falls back to
# rule + LLM matching; with it, Jev scores every job cheaply first.
RUNWARE_API_KEY=replace-me
# SYSTEMONE_MODEL=typesafe:jev@1
# SYSTEMONE_CONFIDENCE=0.75
# SYSTEMONE_BATCH=40
# Jev calls per account per day; they are logged at $0, so the dollar budget cannot limit them.
# SYSTEMONE_DAILY_LIMIT=80
# Assessment rounds per trigger (scan or profile change), each up to 12 LLM verdicts,
# stopping at MATCH_DAILY_BUDGET_USD.
# MATCH_AUTO_ROUNDS=3
# MATCH_BATCH=12
# MATCH_MIN_RANK=35

# Optional: daily job email. Without SMTP_HOST and SMTP_FROM nothing is ever sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# APP_BASE_URL=https://jobcraft.example
# DIGEST_TIME=08:30

# Development only: also create the member account `test-user` at first start.
# BOOTSTRAP_TEST_USER=1

# all: one process does everything (local development).
# web / worker: separate processes on the same data; compose.yaml sets these itself.
# APP_ROLE=all
